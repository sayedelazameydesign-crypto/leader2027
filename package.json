{
  "name": "leader2027",
  "version": "0.1.0",
  "private": true,
  "description": "Leader 2027 — منصة إنتاجية (أول vertical slice)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "test": "vitest run",
    "smoke": "node tests/smoke/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "readme:generate": "node scripts/generate-readme.mjs",
    "readme:check": "node scripts/generate-readme.mjs --check",
    "readme:drift": "node scripts/check-manifest-drift.mjs",
    "readme": "npm run readme:generate && npm run readme:check",
    "readme:warn": "node scripts/generate-readme.mjs --warn-only && node scripts/generate-readme.mjs --check --warn-only"
  },
  "dependencies": {
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

# ── Leader 2027 — متغيرات البيئة ───────────────────────────────────────────
# انسخ الملف إلى .env.local للتطوير، واضبط القيم على المضيف (Vercel) للنشر.
# ⚠️ لا تُرسل أي قيمة سرّية إلى المستودع — هذه أمثلة فقط.

# نوع المخزن: memory (اختبارات) | file (تطوير محلي) | postgres (إنتاج دائم)
L27_STORE=postgres

# رابط PostgreSQL — إلزامي مع L27_STORE=postgres (Neon/Supabase — بلا بطاقة)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB

# مسار ملف البيانات — وضع file فقط
# L27_DB_PATH=var/data/db.json

# سرّ توقيع الجلسة — إلزامي في الإنتاج (الافتراضي مرفوض هناك)
# ولّده: openssl rand -base64 48
L27_SESSION_SECRET=

# ── fixtures البذر ─────────────────────────────────────────────────────────
# حسابات العرض fixtures للتطوير/الاختبار فقط؛ الافتراضي في الإنتاج معطّل.
# Production في Vercel: اضبط L27_SEED_DEMO_ACCOUNTS=0؛ هذا لا يحذف حسابات مخزّنة مسبقًا.
# اضبط 1 فقط لبيئة عرض معزولة ومؤقتة.
# L27_SEED_DEMO_ACCOUNTS=0
# L27_SEED_DEMO_ACCOUNTS=1
# L27_DEMO_PASSWORD=<secret-managed-outside-the-repository>

# مالك البداية للإنتاج (البديل عن حسابات العرض) — يُنشأ مرة واحدة عند أول بذر:
# L27_BOOTSTRAP_OWNER_EMAIL=owner@your-campaign.org
# L27_BOOTSTRAP_OWNER_PASSWORD=<كلمة مرور قوية ≥ 8>

# استثناء صريح للاختبارات الإنتاجية وحدها — لا تستخدمه في نشر حقيقي (يُحذَّر منه في السجلات):
# L27_ALLOW_INSECURE_SECRET=1

# قاعدة الاختبارات العقدية الحيّة للمحوّل (CI/اختبارات فقط):
# L27_TEST_DATABASE_URL=postgres://…

# ── أمان إضافي ─────────────────────────────────────────────────────────────
# نموذج الثقة — المفتاحان **مستقلَّان** تمامًا، لا يفعّل أحدهما الآخر:
#   L27_TRUST_EDGE=1 = "أمامي edge موثوق ينظّف الترويسات" (Vercel / nginx بـREPLACE):
#     ⇒ نثق بترويسة هوية الـIP المُنظَّفة في المُخدد (x-real-ip)
#     ⇒ edge يفرض سياسة الأصل (لا فحص محلي)
#     ⚠️ لا تُفعّله على خادم مكشوف مباشرة — أي عميل يكتب الترويسة بنفسه
#        ⇒ تجاوز كامل لدلة المُخدد.
# L27_TRUST_EDGE=1
#   L27_ALLOWED_HOSTS = سياسة أصل محلية — **لا تمنح أي ثقة بترويسات IP**:
#     كل الطلبات تذهب إلى دلو unknown المشترك (موثّق: الفشل وحده يُستهلك).
# L27_ALLOWED_HOSTS=leader2027.vercel.app,www.leader2027.vercel.app
# الإنتاج يتطلب واحدًا منهما — بدونهما يفشل أي طلب مُغيِّر صراحةً (لا ثقة XFH صامتة).

# ترويسة هوية العميل للمُخدد — تُقرأ خلف L27_TRUST_EDGE=1 فقط، ولا يُقرأ
# x-forwarded-for إطلاقًا (قابل للتدوير من العميل). Vercel: الافتراضي x-real-ip
# صحيح (يُتحقق منه تجريبيًا أول خطوة في النشر):
# L27_CLIENT_IP_HEADER=x-real-ip

# إلحاح خلفية مُخدد الذاكرة (يبدأ من صفر مع cold start — للتجربة فقط؛
# يُحذَّر منه بصوت عالٍ في الإنتاج):
# L27_RATE_BACKEND=memory

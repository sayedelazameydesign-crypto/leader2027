# Leader 2027 — متغيرات البيئة (نموذج فقط: انسخه إلى .env.local ولا ترفع أسراراً حقيقية)
# .env.local مُستثنى في .gitignore — الأسرار الحقيقية تبقى خارج المستودع.

# مخزن البيانات: file (افتراضي — var/data/db.json) أو memory
L27_STORE=file

# مسار حاوية البيانات (خارج شجرة العمل في CI — عزل وحتمية)
L27_DB_PATH=./var/data/db.json

# P2 — fail-closed: إلزامي على الإنتاج (NODE_ENV=production).
# غائب/فارغ/أقصر من 16 حرفاً/مساوٍ لسرّ التطوير ⇒ الخادم يرفض العمل.
# التوليد:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
L27_SESSION_SECRET=

# يُطبع في سجل الخادم عند الإقلاع ليُطابَق مع فحص smoke (إثبات استهلاك الحاوية المعزولة في CI)
L27_CI_RUN=
